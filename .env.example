# Sao chep file nay thanh .env roi dien key that vao
# cp .env.example .env
# CACH TIEN HON: mo app -> nut "API KEY" -> dan key vao, app tu ghi .env (can mat khau)

# Key OpenAI - lay tai https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Key Google Gemini - lay tai https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Key Qwen (Aliyun DashScope) - lay tai https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=
DASHSCOPE_API_KEY=
