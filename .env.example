# Sao chep file nay thanh .env roi dien key that vao
# cp .env.example .env
# CACH TIEN HON: mo app -> nut "API KEY" -> dan key vao, app tu ghi .env (can mat khau)

# Key OpenAI - lay tai https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Key Google Gemini - lay tai https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Key Qwen (Aliyun DashScope) - lay tai https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=
DASHSCOPE_API_KEY=

# Token bot Telegram - tao bot voi @BotFather (/newbot) roi dan token vao day
# Dung cho tinh nang "DOI MAT KHAU TU XA": mo app -> nut TELEGRAM -> dan token + chat ID
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# v1.5.6 ENDPOINT TU DAT (optional) - de TRONG = dung cong chinh mac dinh
# ---------------------------------------------------------------------------
# Mo app -> nut "API KEY" -> sua key -> o "Endpoint" (cuoi dialog).
# Dien gia tri -> app luu vao bien <TEN_KEY>_ENDPOINT va dung no thay cong mac dinh.
# Xoa het = ve cong chinh. Co the dat endpoint cho BAT CU key nao (quy uoc <TEN>_ENDPOINT).
#
# Gemini (SDK google-generativeai): mac dinh cong Google.
GEMINI_API_KEY_ENDPOINT=
# OpenAI / tuong thich OpenAI: mac dinh https://api.openai.com/v1 (do SDK quyet).
OPENAI_API_KEY_ENDPOINT=
# Qwen: mac dinh https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY_ENDPOINT=
# Vi du proxy tuong thich OpenAI:
# OPENAI_API_KEY_ENDPOINT=https://my-proxy.example.com/v1
#
# Bot Telegram: mac dinh https://api.telegram.org (dat khi bi chan / can qua proxy).
TELEGRAM_API_BASE=
